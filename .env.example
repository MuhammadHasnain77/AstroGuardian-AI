# Copy to .env and fill in. .env is git-ignored — never commit real values.
# On Vercel, set these in Project Settings → Environment Variables instead.

# --- Access -------------------------------------------------------------
# There is no password: visitors pick a role on the first screen.
# Signs the role-session cookie. Recommended in production (falls back to a
# fixed demo key). Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database -----------------------------------------------------------
# Empty -> local SQLite file (backend/astroguardian.db), works offline.
# Set to your Neon connection string for Vercel, e.g.
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Seed demo data automatically on first request (default: true for SQLite,
# false for Postgres, where you run `python -m backend.seed` once instead).
# AUTO_SEED=
# Shift demo data forward so it never goes stale (set false in flight).
DEMO_KEEP_FRESH=true

# --- AI assistant -------------------------------------------------------
#   groq  - DEMO ONLY: GPT-OSS-20B hosted on Groq (needs internet + GROQ_API_KEY)
#   local - FLIGHT: the same GPT-OSS-20B served onboard via an OpenAI-compatible
#           server such as Ollama (`ollama pull gpt-oss:20b`). No internet needed.
#   off   - no LLM; template explanations only
# Health alerts are always computed by the deterministic engine either way.
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b          # local default: gpt-oss:20b
# LLM_BASE_URL=http://localhost:11434/v1 # only used with LLM_PROVIDER=local

# --- Real space data ----------------------------------------------------
# live: fetch NOAA proton flux (every 5 min, cached) and NASA DONKI events.
# off:  no network calls (fully offline; onboard dosimeters take over).
SPACE_WEATHER=live
# Free key from https://api.nasa.gov (the shared DEMO_KEY runs out quickly).
NASA_API_KEY=

# --- Engine -------------------------------------------------------------
# Status becomes UNKNOWN if an astronaut's latest reading is older than this.
STALE_DATA_HOURS=36
# Sensor values are carried into a later self-report check-in for this long.
SENSOR_CARRY_HOURS=12
